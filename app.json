{
  "expo": {
    "name": "Lumi",
    "slug": "lumi",
    "scheme": "lumi",
    "version": "1.0.0",
    "platforms": ["ios", "android"],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B0F",
    "primaryColor": "#FFC83D",
    "ios": {
      "bundleIdentifier": "com.vanguard.lumi",
      "buildNumber": "1",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Lumi uses the camera to record video and guide framing and lighting.",
        "NSMicrophoneUsageDescription": "Lumi records sound with your video and gives feedback on your voice."
      },
      "requireFullScreen": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.vanguard.lumi",
      "versionCode": 1,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA", "android.permission.RECORD_AUDIO"],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0B0B0F"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "buildArchs": ["arm64-v8a", "x86_64"]
          },
          "ios": {
            "deploymentTarget": "16.4",
            "privacyManifestAggregationEnabled": true
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Lumi saves your videos to your photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Lumi records sound with your video and gives feedback on your voice.",
          "speechRecognitionPermission": "Lumi listens for voice commands like start recording.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as",
            "com.google.android.tts"
          ]
        }
      ],
      [
        "react-native-audio-api",
        {
          "iosBackgroundMode": false,
          "androidForegroundService": false,
          "androidPermissions": [],
          "disableFFmpeg": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Lumi uses motion to guide you towards a brighter direction during a light scan."
        }
      ],
      [
        "llama.rn",
        {
          "enableEntitlements": false,
          "forceCxx20": false,
          "enableOpenCLAndHexagon": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Lumi uses the camera to record video and guide framing and lighting.",
          "microphonePermission": "Lumi records sound with your video and gives feedback on your voice."
        }
      ],
      "expo-video",
      "expo-sharing"
    ]
  }
}
